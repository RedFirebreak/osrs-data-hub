{
  "name": "@hub/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import=../../tools/dev-env.mjs src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "migrate": "tsx --import=../../tools/dev-env.mjs src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hub/core": "workspace:*",
    "@hub/db": "workspace:*",
    "@hub/server": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg-boss": "12.35.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
