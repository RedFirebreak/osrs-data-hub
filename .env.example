# ---------------------------------------------------------------------------
# osrs-data-hub configuration. Copy to .env and fill in. Defaults are shown.
# One guild per deployment: another clan self-hosts by changing these values.
# ---------------------------------------------------------------------------

# Public base URL shown in the pairing wizard. Must include the scheme (https://).
# The plugin appends /api/osrs-data/pair and /api/osrs-data/events to it.
APP_URL=https://hub.example.com
# Returned as "name" from /pair; becomes the connection name in the plugin (max 64 chars).
HUB_NAME=osrs-data-hub
MIN_PLUGIN_VERSION=1.5

# Postgres + TimescaleDB
DATABASE_URL=postgres://hub:change-me@db:5432/hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hub

# Better Auth. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Discord OAuth app (scopes: identify guilds.members.read)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token, used only for the 6-hourly membership re-verification. The bot needs no permissions
# and no privileged intents; it only has to be in the guild.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Shown in "not a member of <guild>" messages.
DISCORD_GUILD_NAME=
# Optional, comma-separated, any-of.
DISCORD_REQUIRED_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
# Bootstrap admins (comma-separated Discord user ids).
ADMIN_DISCORD_USER_IDS=

OFFBOARD_GRACE_DAYS=30
PAIRING_CODE_TTL_SECONDS=300
XP_RAW_RETENTION_DAYS=365
LOCATION_RETENTION_DAYS=30
RAW_PAYLOAD_RETENTION_HOURS=72
AUDIT_LOG_RETENTION_DAYS=730
INGEST_MAX_BODY_KB=256

# Number of reverse proxies in front of the web service whose X-Forwarded-For entries are trusted
# (used for the /pair rate limits). 0 = ignore X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Protects /metrics (send as "Authorization: Bearer <token>"). Empty = /metrics disabled (404), on the
# web service and the worker alike. Generate with: openssl rand -hex 32
METRICS_TOKEN=
# The worker's own /metrics port (jobs, re-verification, retention; D-84). compose.yaml publishes it on
# WORKER_METRICS_BIND (default 127.0.0.1); set that to the VM's PRIVATE address for a Prometheus on
# another machine, never to a public one. 0 = no worker endpoint.
WORKER_METRICS_PORT=9464
WORKER_METRICS_BIND=127.0.0.1
LOG_LEVEL=info
